# ──────────────────────────────────────────────────────────────
# Horizon - AI Project Intelligence — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in your actual values:
#   cp .env.example backend/.env
# ──────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=ai_project_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000

# Frontend (React)
REACT_APP_API_URL=http://localhost:8000
